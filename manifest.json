{
  "manifest_version": 3,
  "name": "ChatStamp: Timestamps for AI Chats",
  "version": "0.4.0",
  "description": "Shows when each chat started in the ChatGPT and Claude sidebars. All data stays on your device.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://claude.ai/*"
      ],
      "js": [
        "src/shared/core.js",
        "src/shared/format.js",
        "src/shared/storage.js",
        "src/platforms/chatgpt.js",
        "src/platforms/claude.js",
        "src/content/collector.js",
        "src/content/injector.js",
        "src/content/messages.js",
        "src/content/navigation.js",
        "src/content/main.js"
      ],
      "css": ["src/content/labels.css"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "src/pages/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "ChatStamp: Timestamps for AI Chats",
    "default_popup": "src/pages/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
